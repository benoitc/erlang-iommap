{application, iommap, [
    {description, "Memory-mapped file I/O NIF for Erlang"},
    {vsn, "1.1.1"},
    {registered, []},
    {applications, [kernel, stdlib]},
    {env, []},
    {modules, [iommap]},
    {licenses, ["MIT"]},
    {links, [
        {"GitHub", "https://github.com/benoitc/erlang-iommap"},
        {"Changelog", "https://github.com/benoitc/erlang-iommap/blob/main/CHANGELOG.md"}
    ]},
    {files, [
        "src",
        "c_src",
        "guides",
        "rebar.config",
        "rebar.lock",
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
        "Makefile"
    ]},
    {build_tools, ["rebar3"]},
    {exclude_files, ["priv"]}
]}.
